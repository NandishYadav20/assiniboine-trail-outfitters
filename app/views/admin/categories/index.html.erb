<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3">Categories</h1>
  <div>
    <%= link_to "Products", admin_products_path, class: "btn btn-outline-secondary" %>
    <%= link_to "Add category", new_admin_category_path, class: "btn btn-primary" %>
  </div>
</div>
<table class="table table-striped align-middle">
  <thead><tr><th>Name</th><th>Description</th><th></th></tr></thead>
  <tbody>
    <% @categories.each do |category| %>
      <tr>
        <td><%= category.name %></td>
        <td><%= category.description %></td>
        <td class="text-end">
          <%= link_to "Edit", edit_admin_category_path(category), class: "btn btn-sm btn-outline-primary" %>
          <%= button_to "Delete", admin_category_path(category), method: :delete, class: "btn btn-sm btn-outline-danger", form: { style: "display:inline" } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

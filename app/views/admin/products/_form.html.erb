<%= render "shared/errors", object: product %>
<%= form_with model: [:admin, product], multipart: true do |f| %>
  <div class="row g-3">
    <div class="col-md-6"><%= f.label :name, class: "form-label" %><%= f.text_field :name, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :sku, "SKU", class: "form-label" %><%= f.text_field :sku, class: "form-control" %></div>
    <div class="col-md-6">
      <%= f.label :category_id, "Category", class: "form-label" %>
      <%= f.collection_select :category_id, Category.order(:name), :id, :name, { prompt: "Choose a category" }, class: "form-select" %>
    </div>
    <div class="col-md-3"><%= f.label :price, class: "form-label" %><%= f.number_field :price, step: "0.01", class: "form-control" %></div>
    <div class="col-md-3"><%= f.label :stock_quantity, "Stock", class: "form-label" %><%= f.number_field :stock_quantity, class: "form-control" %></div>
    <div class="col-12"><%= f.label :description, class: "form-label" %><%= f.text_area :description, rows: 4, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :image, class: "form-label" %><%= f.file_field :image, accept: "image/*", class: "form-control" %></div>
    <div class="col-md-6 form-check mt-4">
      <%= f.check_box :active, class: "form-check-input" %>
      <%= f.label :active, "Show in store", class: "form-check-label" %>
    </div>
  </div>
  <div class="mt-4"><%= f.submit class: "btn btn-primary" %></div>
<% end %>

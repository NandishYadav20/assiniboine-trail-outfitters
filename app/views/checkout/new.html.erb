<h1 class="h3">Checkout</h1>
<%= render "shared/errors", object: @customer %>

<%= form_with model: @customer, url: checkout_path, method: :post do |f| %>
  <div class="row g-3">
    <div class="col-md-6"><%= f.label :first_name, class: "form-label" %><%= f.text_field :first_name, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :last_name, class: "form-label" %><%= f.text_field :last_name, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :email, class: "form-label" %><%= f.email_field :email, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :phone, class: "form-label" %><%= f.telephone_field :phone, class: "form-control" %></div>
    <div class="col-12"><%= f.label :address_line, class: "form-label" %><%= f.text_field :address_line, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :city, class: "form-label" %><%= f.text_field :city, class: "form-control" %></div>
    <div class="col-md-3">
      <%= f.label :province_id, "Province", class: "form-label" %>
      <%= f.collection_select :province_id, Province.order(:name), :id, :name, { prompt: "Choose" }, class: "form-select" %>
    </div>
    <div class="col-md-3"><%= f.label :postal_code, class: "form-label" %><%= f.text_field :postal_code, class: "form-control" %></div>
  </div>
  <div class="mt-4"><%= f.submit "Place order", class: "btn btn-success" %></div>
<% end %>

<nav aria-label="breadcrumb">
  <ol class="breadcrumb">
    <li class="breadcrumb-item"><%= link_to "Home", root_path %></li>
    <li class="breadcrumb-item"><%= link_to @product.category.name, category_path(@product.category) %></li>
    <li class="breadcrumb-item active" aria-current="page"><%= @product.name %></li>
  </ol>
</nav>

<div class="row">
  <div class="col-md-6">
    <% if @product.image.attached? %>
      <%= image_tag @product.image, class: "img-fluid rounded", alt: @product.name %>
    <% else %>
      <div class="bg-secondary-subtle rounded p-5 text-center">No image yet</div>
    <% end %>
  </div>
  <div class="col-md-6">
    <h1 class="h3"><%= @product.name %></h1>
    <p class="text-muted">SKU: <%= @product.sku %></p>
    <p class="fs-4 fw-bold"><%= number_to_currency(@product.price) %></p>
    <p><%= @product.description %></p>
    <% if @product.stock_quantity > 0 %>
      <p>In stock: <%= @product.stock_quantity %></p>
      <%= form_with url: cart_items_path, method: :post, class: "d-flex gap-2 align-items-center" do %>
        <%= hidden_field_tag :product_id, @product.id %>
        <%= number_field_tag :quantity, 1, min: 1, max: @product.stock_quantity, class: "form-control", style: "width: 100px" %>
        <%= submit_tag "Add to cart", class: "btn btn-primary" %>
      <% end %>
    <% else %>
      <p class="text-danger">Out of stock</p>
    <% end %>
  </div>
</div>
